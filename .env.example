# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_MARKET=JP
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id

# Password for adding tracks (letters and numbers allowed).
# Used until it is changed from /admin; the Blob value takes precedence after that.
REQUEST_PASSWORD=change_this_request_password

# /admin login only. Changing REQUEST_PASSWORD from /admin does not affect it.
ADMIN_PASSWORD=change_this_admin_password
# Signs the admin session cookie. Use a long random value.
ADMIN_SESSION_SECRET=change_this_random_secret

# Private Blob store for settings.json (request on/off and request password).
# Added automatically when the Blob store is connected to the Vercel project.
# For local development, copy it from the project settings or run `vercel env pull`.
# Leave empty to keep requests open and use REQUEST_PASSWORD only.
BLOB_READ_WRITE_TOKEN=
